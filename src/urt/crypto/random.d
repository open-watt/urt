module urt.crypto.random;

import urt.result;

version (Bouffalo)
{
    version (BL808_D0) {} else
        version = DirectBouffaloTRNG;
}

version (Espressif)
{
    // use the hardware RNG peripheral on ESP32
}
else version (MbedTLS)
{
    import urt.internal.mbedtls;
}
else version (Windows)
{
    import core.sys.windows.bcrypt;
    import core.sys.windows.ntdef : NTSTATUS;
    pragma(lib, "Bcrypt");
}

nothrow @nogc:


// A failed request must not leave partially generated bytes available to callers.
Result crypto_random_bytes(ubyte[] dst)
{
    if (dst.length == 0)
        return Result.success;
    Result result;
    version (unittest)
    {
        if (crypto_random_override)
            result = crypto_random_override(dst);
        else
            result = fill_random(dst);
    }
    else
        result = fill_random(dst);
    if (result.failed)
        dst[] = 0;
    return result;
}


version (unittest)
    __gshared Result function(ubyte[]) nothrow @nogc crypto_random_override;


private Result fill_random(ubyte[] dst)
{
    version (Espressif)
    {
        return urt_crypto_random(dst.ptr, dst.length) ? Result.success : InternalResult.failed;
    }
    else version (DirectBouffaloTRNG)
    {
        import urt.driver.bl_common.trng : trng_read;
        return trng_read(dst) ? Result.success : InternalResult.failed;
    }
    else version (MbedTLS)
    {
        int ret = urt_rng_random(dst.ptr, dst.length);
        return ret == 0 ? Result.success : Result(cast(uint)ret);
    }
    else version (Windows)
    {
        NTSTATUS status = BCryptGenRandom(null, dst.ptr, cast(uint)dst.length, BCRYPT_USE_SYSTEM_PREFERRED_RNG);
        return status == 0 ? Result.success : Result(cast(uint)status);
    }
    else version (Beken)
    {
        import urt.driver.bk7231.trng : trng_read;
        return trng_read(dst) ? Result.success : InternalResult.failed;
    }
    else version (RP2350)
    {
        import urt.driver.rp2350.trng : trng_read;
        return trng_read(dst) ? Result.success : InternalResult.failed;
    }
    else version (STM32)
    {
        import urt.driver.stm32.trng : trng_read;
        return trng_read(dst) ? Result.success : InternalResult.failed;
    }
    else version (Posix)
    {
        import urt.internal.stdc.errno : errno, EINTR;
        while (!dst.empty)
        {
            size_t n = dst.length < 256 ? dst.length : 256;
            if (getentropy(dst.ptr, n) != 0)
            {
                if (errno == EINTR)
                    continue;
                return Result(cast(uint)errno);
            }
            dst = dst[n .. $];
        }
        return Result.success;
    }
    else
        return InternalResult.unsupported;
}


private:

// ESP requests fail until an RF entropy source is active. The shim holds the PHY
// lock across the read; it never enables the shared SAR ADC behind its owner.
version (Espressif)
{
    extern(C) bool urt_crypto_random(void* buf, size_t len) nothrow @nogc;
}

else version (Posix)
    extern(C) int getentropy(void* buf, size_t len) nothrow @nogc;


unittest
{
    assert(crypto_random_bytes(null).succeeded);
    ubyte[48] a = 0xCD, b = 0xCD;
    const result = crypto_random_bytes(a);
    if (result.failed)
    {
        foreach (value; a)
            assert(value == 0);
    }
    else if (crypto_random_bytes(b).succeeded)
        assert(a[] != b[]);
    else
    {
        foreach (value; b)
            assert(value == 0);
    }

    crypto_random_override = (ubyte[] dst) nothrow @nogc
    {
        dst[0 .. dst.length / 2] = 0xAB;
        return InternalResult.failed;
    };
    scope(exit) crypto_random_override = null;
    a[] = 0xCD;
    assert(crypto_random_bytes(a).failed);
    foreach (value; a)
        assert(value == 0);
}
